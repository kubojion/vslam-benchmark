+void ROS2Visualizer::callback_input_image(const sensor_msgs::msg::Image::ConstSharedPtr msg, int camera) {
+  const auto stamp = static_cast<std::uint64_t>(msg->header.stamp.sec) * 1000000000ULL + msg->header.stamp.nanosec;
+  std::lock_guard<std::mutex> lock(input_stamp_mtx_);
+  (camera == 0 ? input_left_stamps_ : input_right_stamps_).push_back(stamp);
+}
+
+void ROS2Visualizer::callback_input_progress(const std_msgs::msg::UInt64MultiArray::SharedPtr msg) {
+  // Acknowledge application receipt, not DDS delivery or filter accuracy.
+  // Do not require a camera update: initialization and positive time offsets
+  // can require future real IMU samples. The queue/worker behavior is unchanged.
+  if (!input_flow_enabled_ || msg->data.size() != 3 || msg->data[0] != 1 ||
+      input_imu_received_.load() != msg->data[1] || input_stereo_received_.load() != msg->data[2] ||
+      input_camera_queued_.load() != msg->data[2] || input_left_stamps_.size() != msg->data[2] ||
+      input_right_stamps_.size() != msg->data[2])
+    return;
+  std_msgs::msg::UInt64MultiArray ack;
+  ack.data = {1, input_imu_received_.load(), input_stereo_received_.load(), input_camera_queued_.load()};
+  ++input_progress_acks_;
+  pub_input_progress_ack_->publish(ack);
+}
+
+void ROS2Visualizer::callback_input_end(const std_msgs::msg::UInt64MultiArray::SharedPtr msg) {
+  // All subscriptions use this node's default mutually-exclusive callback group.
+  // The independent update worker may still be busy; the player retries this
+  // control message until all real input has arrived and that worker is idle.
+  if (!input_end_enabled_ || msg->data.size() != 3 || msg->data[0] != 1 ||
+      _app->get_params().state_options.num_cameras != 2 || msg->data[1] == 0 ||
+      input_imu_received_.load() != msg->data[1] || input_stereo_received_.load() != msg->data[2] ||
+      input_camera_queued_.load() != msg->data[2] || thread_update_running.load())
+    return;
+
+  std::lock_guard<std::mutex> lock(camera_queue_mtx);
+  if (!input_end_complete_) {
+    std::uint64_t last_imu_ns;
+    {
+      std::lock_guard<std::mutex> stamp_lock(input_stamp_mtx_);
+      if (input_imu_stamps_.empty()) return;
+      last_imu_ns = input_imu_stamps_.back();
+    }
+    // Reproduce the native sec + nanosec conversion exactly. This is a
+    // watermark for IMU samples already fed, never a new IMU measurement.
+    const double last_imu_s = static_cast<double>(last_imu_ns / 1000000000ULL)
+                           + (last_imu_ns % 1000000000ULL) * 1e-9;
+    while (!camera_queue.empty()) {
+      const double timestamp_imu_inC = last_imu_s - _app->get_state()->_calib_dt_CAMtoIMU->value()(0);
+      if (!(camera_queue.front().timestamp < timestamp_imu_inC)) break;
+      auto start = boost::posix_time::microsec_clock::local_time();
+      const double update_dt = 100.0 * (timestamp_imu_inC - camera_queue.front().timestamp);
+      _app->feed_measurement_camera(camera_queue.front());
+      input_camera_processed_.fetch_add(1, std::memory_order_relaxed);
+      ++input_end_drained_;
+      visualize();
+      camera_queue.pop_front();
+      const double elapsed = (boost::posix_time::microsec_clock::local_time() - start).total_microseconds() * 1e-6;
+      PRINT_INFO(BLUE "[TIME]: %.4f seconds total (%.1f hz, %.2f ms behind) [end-of-recording]\n" RESET,
+                 elapsed, elapsed > 0 ? 1.0 / elapsed : 0.0, update_dt);
+    }
+    input_end_expected_imu_ = msg->data[1];
+    input_end_expected_stereo_ = msg->data[2];
+    input_end_complete_ = true;
+  }
+  // Repeated control messages only repeat the acknowledgement. No sample is
+  // replayed, and no camera lacking a later real IMU sample is forced through.
+  std_msgs::msg::UInt64MultiArray ack;
+  ack.data = {1, input_imu_received_.load(), input_stereo_received_.load(),
+              input_camera_queued_.load(), input_camera_processed_.load(),
+              static_cast<std::uint64_t>(camera_queue.size()), input_end_drained_};
+  pub_input_end_ack_->publish(ack);
+}
