# --- bulky / generated / private ---
datasets/
obsolete/
logs/
docs/private/
patches/
*.log
*.bak

# --- run-type result trees (regenerable) ---
results/

# --- large binary result artefacts (SLAM map files) ---
results-*/**/*.bin
# OKVIS2-X keeps the app's raw CSVs next to the derived trajectory.txt
# (~6 MB each, 5 per run). trajectory.txt + run_eval.json are the record;
# the raw CSVs are regenerable by re-running. Note the '-' after okvis2:
# this deliberately does not match okvis2_raw_trajectory.csv, which is tracked.
results-*/**/okvis2-*trajectory.csv
results-*/**/okvis2-*-final_map.*
**/rtabmap.db

# --- compiled SLAM artefacts (submodule trees, never commit build output) ---
src/ORB_SLAM3/build/
src/ORB_SLAM3/lib/
src/ORB_SLAM3/Vocabulary/ORBvoc.txt.tar.gz
src/DROID-SLAM/**/__pycache__/
src/DROID-SLAM/build/
src/DROID-SLAM/*.egg-info/
src/MAC-VO/Sandbox/
src/MAC-VO/Results/
src/MAC-VO/Model/*.pth
src/MAC-VO/Model/*.pkl
src/open_vins/build/
src/open_vins/**/__pycache__/
third_party/Pangolin/build/

# --- model weights and compiled inference engines ---
*.pth
*.pkl
*.pt
*.ckpt
*.engine

# --- editor / python ---
*.pyc
*.so
.venv/
__pycache__/
.vscode/
.DS_Store
*.swp

# DPVO build tree + local thirdparty (setup_dpvo_env.sh regenerates)
src/DPVO/build/
src/DPVO/thirdparty/eigen-3.4.0/
src/DPVO/saved_trajectories/
