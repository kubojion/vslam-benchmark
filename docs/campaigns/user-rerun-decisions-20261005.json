 "decided_by": "user (project lead), recorded by Claude",
 "scope": "Attempts the user decided to replace by new N=3 runs (HortiMulti one IMU profile and camera-clock input; OV2SLAM HortiMulti parameters; OpenVINS frame throttle on HortiMulti, ZED and CitrusFarm; CitrusFarm ORB-SLAM3 r1 after the ORB-SLAM3 source commit). Each record pins one attempt path and its recorded binaries; replacement runs get new physical run IDs and never inherit a finding. Original folders are kept. Separate from user-rerun-decisions-20261003.json so the bytes earlier reviews pin stay unchanged.",
 "decisions": {
  "horti_inertial_one_profile": {
   "code": "horti_imu_profile_and_clock_inconsistent",
   "disposition": "required_rerun",
   "prerequisite": "rerun_with_one_envelope_imu_noise_profile_and_camera_clock_imu_input_for_every_estimator",
   "evidence": [
    "docs/hortimulti-decisions-20261005.md",
    "docs/okvis-imu-noise-derivation.md",
    "docs/campaigns/horti-time-offset-findings-20261001.json"
   ],
   "explanation": "Saved HortiMulti inertial attempts used three IMU noise profiles (dataset Allan values, the recording-derived envelope, Basalt sweep leftovers) and four treatments of the published 9.16 ms camera-IMU relation. Decision (user, 2026-10-05): one envelope profile for every estimator and one camera-clock IMU input with zero native offsets; replace every saved VIO/VIO-LC attempt."
  },
  "ov2slam_horti_parameters": {
   "code": "ov2slam_horti_dataset_specific_parameters",
   "disposition": "required_rerun",
   "prerequisite": "rerun_with_accurate_profile_values_used_on_every_dataset",
   "evidence": [
    "docs/hortimulti-decisions-20261005.md"
   ],
   "explanation": "HortiMulti alone used finit_parallax 15 and nmin_covscore 20 (no recorded reason); upstream accurate profile and every other dataset use 20 and 25. Decision (user, 2026-10-05): rerun."
  },
  "openvins_frame_throttle": {
   "code": "openvins_track_frequency_dropped_frames",
   "disposition": "required_rerun",
   "prerequisite": "rerun_with_track_frequency_above_every_camera_interval",
   "evidence": [
    "docs/hortimulti-decisions-20261005.md"
   ],
   "explanation": "track_frequency equal to the 10 Hz camera rate made the ROS front end drop every frame arriving less than 0.1 s after the last accepted one: 62 % (HortiMulti), 51 % (ZED) and about 63 % (CitrusFarm) of frames processed. Decision (user, 2026-10-05): track_frequency 31, rerun."
  },
  "orb_source_commit_single_group": {
   "code": "orb_source_identity_changed_partial_cell",
   "disposition": "required_rerun",
   "prerequisite": "rerun_all_three_repetitions_in_one_recorded_implementation_group",
   "evidence": [
    "docs/hortimulti-decisions-20261005.md"
   ],
   "explanation": "The ORB-SLAM3 start-of-sequence bounds fix (Examples/Stereo-Inertial/stereo_inertial_euroc.cc, compiled into the binary since 2026-09-15 and recorded per run as an uncommitted diff) was committed in the submodule (user, 2026-10-05). The recorded algorithm source identity changes, so CitrusFarm cells holding only r1 cannot be pooled with later repetitions; r1 is replaced so all three repetitions form one group."
  }
 },
